# Vasco configuration template.
# Copy to $XDG_CONFIG_HOME/vasco/config.yaml and uncomment what you need.
# Every key below shows its built-in default value; the trailing comment lists the
# allowed/possible values. Uncommenting a line as-is is a no-op (it equals the default).
#
# Precedence: CLI flag > env var > this file > built-in default.
# Env vars are VASCO_<SECTION>_<FIELD>=value (e.g. VASCO_FETCH_WORKERS=8). Adapter
# sections nest under `adapters`, so their env prefix is VASCO_ADAPTERS_<SUB>_<FIELD>
# (e.g. VASCO_ADAPTERS_STEAM_COUNTRY=US).

# search:
#   region: us-en              # DuckDuckGo region code (e.g. us-en, br-pt, uk-en)
#   max_results: 10            # results returned per search

# fetch:
#   workers: 4                 # thread-pool size for fetch_many
#   ttl_seconds: 86400         # cache TTL for successful fetches (seconds)
#   failure_ttl_seconds: 900   # base negative-cache TTL; scaled per failure reason
#   deadline_seconds: 30.0     # hard per-fetch upper bound / kill-switch (seconds)
#   user_agent: "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# browser:                      # all resolved server-side by `vasco browser-server`
#   headless: true             # true | false
#   locale: en-US              # browser UI locale
#   spoof_os: ""               # "" = match host | windows | macos | linux
#   prewarm: false             # MCP-only: warm Camoufox at server startup
#   user_data_dir: ""          # persistent profile dir; "" = ephemeral (no cookies)
#   block_ads: true            # abort third-party ad/tracker requests (faster renders)
#   network_blocklist_paths: []  # local files or remote URLs; [] = bundled default
#   clear_cookies_on_wall: true  # on a login wall, clear that domain's cookies + retry once
#   # --- Cloudflare Turnstile solving (opt-in; all off = today's behavior) ---
#   solve_turnstile: false     # auto-click the challenge checkbox + wait for clearance
#   virtual_display: false     # launch a real (non-headless) Firefox in Xvfb; REQUIRES Xvfb
#   humanize: false            # human-like (Bezier) cursor movement; needed to click
#   disable_coop: false        # allow clicking the cross-origin Turnstile iframe
#   block_images: false        # skip image loading to cut headful render cost
#   window: []                 # fixed [width, height]; [] = Camoufox random
#   # --- Manual (human-in-the-loop) solving via VNC, for what auto-solve can't clear ---
#   manual_solve: false        # notify-send + hold the page open for a human via VNC
#   manual_solve_timeout: 60.0 # seconds to hold for a human before resuming as normal
#   vnc_display_size: [1280, 720]  # managed Xvfb framebuffer [width, height]
#   vnc_display: ":99"         # managed Xvfb display number (auto-fallback if taken)
#   vnc_port: 5900             # x11vnc loopback port -> connect to localhost:5900

# cache:
#   path: ""                   # "" = $XDG_DATA_HOME/vasco/cache.sqlite

# logging:
#   enabled: true              # true | false (logs successes too)
#   path: ""                   # "" = $XDG_DATA_HOME/vasco/logs

# ocr:                          # Tesseract OCR fallback for image-only (scanned) PDF pages
#   enabled: true              # true | false (false = pdftotext only, today's behavior)
#   language: eng              # tesseract -l code(s), e.g. "eng+por" (traineddata must be installed)
#   dpi: 200                   # pdftoppm rasterization DPI (300 = better, slower)
#   max_pages: 50              # cap pages OCR'd per document (cost/latency guard)
#   min_page_chars: 16         # a page's native text below this ⇒ OCR that page

# quality:                      # set this section to `false` (or remove it) to disable scoring
#   blocklist_paths: []        # local files or remote URLs (plain-domain or uBlacklist); [] = bundled
#   detect_paywall: true       # flag pages served by known paywall/metering vendors
#   paywall_vendor_paths: []   # vendor fingerprint lists (local/remote); [] = bundled default

# answer:                       # backend(s) for the `answer` command (fetch + LLM answer over a page)
#                               # `providers` is an ordered chain: first = primary, the rest are fallbacks
#                               # tried in order when an entry is unavailable or fails. empty = disabled.
#   providers: []              # e.g. (uncomment and fill — first entry is primary):
#                               #   - {provider: claude_cli, model: sonnet}
#                               #   - {provider: deepseek, model: deepseek-v4-flash, api_key: sk-...}
#                               # claude_cli runs `claude -p` on your subscription: `claude` must be on PATH
#                               # (incl. the vascod service's PATH) and logged in (run `claude`, then /login);
#                               # the adapter strips ANTHROPIC_API_KEY so it bills the subscription, not the API.
#                               # quick single-provider override (replaces the whole chain):
#                               #   VASCO_ANSWER_PROVIDER=claude_cli VASCO_ANSWER_MODEL=sonnet

# service:                      # vascod (`vasco serve`) coordination knobs
#   single_flight: true        # collapse concurrent identical fetches into one
#   rate_limit_rps: 1.0        # max network fetch starts/sec per domain; 0 = off
#   max_concurrent_per_domain: 2  # max simultaneous in-flight fetches per domain; 0 = unlimited

# domains:                      # per-host fetch overrides (keyed by host; YAML only)
#   gitlab.wikimedia.org:       # headers: browser (default modern-Chrome shape)
#     headers: honest           #        | honest (minimal client headers — for WAFs
#   git.example.com: honest     # that 403 the half-fingerprint). Shorthand: host: honest.
#                               # Known public GitLab hosts are already seeded honest
#                               # in code; the http tier also learns honest on a 403.

# adapters:                     # per-source content adapters (env: VASCO_ADAPTERS_<SUB>_<FIELD>)
#   shopping:                   # Google Shopping (labels only; parser is PT-BR)
#     currency: BRL            # label stamped on the envelope
#     language: pt-BR          # label stamped on the envelope
#   aliexpress:
#     currency: USD            # label stamped on the envelope
#     language: en_US          # AliExpress locale code (underscore); drives the reviews endpoint
#     country: US              # reviews endpoint country
#     reviews_page_size: 6     # top reviews fetched per product page
#   mercadolivre:
#     relevance_filter: true   # relevance-sort search results so ad-placement off-keyword items sink
#     drop_off_query: false    # true = hard-drop off-keyword (loses synonyms); false = demote only
#     min_query_token_coverage: 1  # when dropping: min distinct query tokens a result must match
#   shopify:                    # generic Shopify (product/collection/search via platform JSON)
#     domains: []              # extra registered domains to always treat as Shopify (myshopify.com auto)
#     autodetect: true         # probe unknown product/collection URLs; fall through on a miss
#     collection_limit: 250    # products.json page-size cap (Shopify hard-caps at 250)
#   shopee:                     # Shopee BR (product pages via Product JSON-LD)
#     currency: BRL            # label stamped on the envelope
#     language: pt-BR          # label stamped on the envelope
#   petlove:                    # Petlove BR (search + product pages via JSON-LD)
#     currency: BRL            # label stamped on the envelope
#     language: pt-BR          # label stamped on the envelope
#     max_reviews: 10          # cap embedded customer reviews parsed per product page
#   steam:                      # Steam store (app pages + search via store JSON APIs)
#     country: US              # Steam storefront cc — sets the price currency (US -> USD)
#     language: english        # Steam storefront l — locale of descriptions/genres
#     itad_api_key: ""         # IsThereAnyDeal key (or VASCO_ITAD_API_KEY); "" = off. Currency follows `country`
#   phabricator:                # Phabricator/Phorge tasks + task search (HTML scrape, public data only)
#     domains: []              # extra Phorge instance hosts (phabricator.wikimedia.org built in)
#     max_comments: 50         # cap timeline comments parsed per task page
#   gitlab:                     # GitLab projects + issues + merge requests (public /api/v4, no auth)
#     domains: []              # extra known GitLab hosts (gitlab.com built in); skips the probe
#     autodetect: true         # probe unknown hosts on claimable URLs (falls through on a miss)
#     max_comments: 20         # cap issue/MR notes (comments) parsed
#   youtube:                    # video transcripts + channel/playlist/search video listings
#     cookies_from_browser: "" # "" = off | firefox | chrome | brave | ...
#     remote_components: ""    # "" = off (opt-in) | "ejs:github" enables yt-dlp's JS
#                              # challenge solver (needs deno/a JS runtime on PATH).
#                              # Fetches+runs solver code from GitHub — see caveats.
#     max_videos: 50           # cap on videos listed for a channel/playlist/search URL
#   wikimedia:                  # "" = anonymous free REST API (all langs, no cap)
#     username: ""             # Wikimedia Enterprise account (or VASCO_ADAPTERS_WIKIMEDIA_USERNAME)
#     password: ""             # (or VASCO_ADAPTERS_WIKIMEDIA_PASSWORD)
