# Vasco configuration template.
# Copy to $XDG_CONFIG_HOME/vasco/config.yaml and uncomment what you need.
# Env vars (VASCO_<SECTION>_<FIELD>=value) override anything set here.
# CLI flags (where present) override env vars.

# search:
#   default_backend: ddg        # "ddg" (DuckDuckGo metasearch)
#   region: us-en
#   max_results: 10

# fetch:
#   default_mode: auto          # "auto" | "http" | "browser" | "wayback"
#   workers: 4
#   ttl_seconds: 86400
#   failure_ttl_seconds: 900
#   deadline_seconds: 30.0
#   user_agent: "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# browser:
#   headless: true
#   locale: en-US
#   spoof_os: ""                # Camoufox OS persona (windows/macos/linux); empty = match the host OS
#   prewarm: false              # MCP-only: warm Camoufox at server startup
#   user_data_dir: ""           # persistent profile dir; non-empty enables cookie persistence
#   block_ads: true             # abort third-party ad/tracker requests to cut page weight → faster renders (default on)
#   network_blocklist_paths:    # hostlists for ad/tracker blocking; empty = bundled conservative default
#     - ~/.config/vasco/netblock.txt
#     - https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/light-onlydomains.txt
#   clear_cookies_on_wall: true # on a login wall (e.g. MercadoLivre account-verification), clear that
#                               #   domain's cookies + retry once (default on; only acts on a persistent
#                               #   user_data_dir; domain-scoped so other sites' cookies are preserved)
#   # --- Cloudflare Turnstile solving (opt-in; all off = today's behavior) ---
#   solve_turnstile: false      # click the challenge checkbox + wait for clearance
#   virtual_display: false      # launch a real (non-headless) Firefox in Xvfb; REQUIRES Xvfb
#                               #   installed on the host (e.g. `pacman -S xorg-server-xvfb`)
#   humanize: true              # human-like (Bezier) cursor movement; needed to click the checkbox
#   disable_coop: true          # allow clicking the cross-origin Turnstile iframe
#   block_images: false         # skip image loading to cut the headful render cost
#   window: [1280, 720]         # fixed window size; omit for a random one
#   # NOTE: solving needs a persistent user_data_dir so the cf_clearance cookie is
#   # reused across fetches once obtained. Set virtual_display+humanize+disable_coop
#   # +solve_turnstile together; they're a unit.
#   # --- Manual (human-in-the-loop) solving via VNC, for challenges the auto-solve
#   # can't clear. When on, vasco runs its own sized Xvfb + x11vnc (loopback) and,
#   # on an unsolvable challenge, fires notify-send + holds the page open so you can
#   # connect a VNC viewer and solve by hand. `vasco browser-solve <url>` triggers it.
#   manual_solve: false         # enable the notify + VNC hold fallback
#   manual_solve_timeout: 60.0  # seconds to hold for a human before resuming as normal
#   vnc_display_size: [1280, 720]
#   vnc_display: ":99"          # managed Xvfb display (auto-falls back if taken)
#   vnc_port: 5900              # x11vnc loopback port → connect to localhost:5900

# cache:
#   path: ""                    # empty → $XDG_DATA_HOME/vasco/cache.sqlite

# logging:
#   enabled: true
#   path: ""                    # empty → $XDG_DATA_HOME/vasco/logs

# youtube:
#   cookies_from_browser: ""    # "" disables; e.g. "firefox", "chrome", "brave"

# wikimedia:
#   username: ""                # Wikimedia Enterprise account; or VASCO_WIKIMEDIA_USERNAME
#   password: ""                # or VASCO_WIKIMEDIA_PASSWORD
#                               # Sign up free at https://dashboard.enterprise.wikimedia.com/signup/
#                               # Without credentials, falls back to the free REST API (all languages, no cap)

# quality:                       # remove or set to `false` to disable scoring entirely
#   blocklist_paths:            # local files or remote URLs (plain-domain or uBlacklist format)
#     - ~/.config/vasco/blocklist.txt
#     - https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/fake-onlydomains.txt
#   detect_paywall: true        # flag pages served by known paywall/metering vendors (default on)
#   paywall_vendor_paths:       # vendor fingerprint lists (local or remote); empty = bundled default
#     - ~/.config/vasco/paywall_vendors.txt

# answer:                        # LLM endpoint for the `answer` command (fetch + LLM answer over a page)
#   model: deepseek-v4-flash
#   base_url: https://api.deepseek.com/v1   # any OpenAI-compatible chat endpoint
#   api_key: ""                 # or set DEEPSEEK_API_KEY / VASCO_ANSWER_API_KEY

# aliexpress:                    # AliExpress adapter (search cards + detail/reviews)
#   currency: BRL               # label stamped on the envelope
#   language: pt_BR             # AliExpress locale code (underscore); drives the reviews endpoint
#   country: BR
#   reviews_page_size: 6        # top reviews fetched per product page from feedback.aliexpress.com
#                               # needs the browser tier with a warm/cleared persistent profile

# mercadolivre:                  # MercadoLivre adapter (search + product)
#   relevance_filter: true      # relevance-sort search results so ad-placement off-keyword items sink
#   drop_off_query: false       # true = hard-drop off-keyword results (loses synonyms); false = demote only
#   min_query_token_coverage: 1 # when dropping: min distinct query tokens a result must match (1 = zero-keyword)

# shopify:                       # generic Shopify adapter (product/collection/search via platform JSON)
#   domains: []                 # extra registered domains to always treat as Shopify (myshopify.com auto)
#   autodetect: true            # probe unknown product/collection URLs; fall through to normal fetch on a miss
#   collection_limit: 250       # products.json page size cap (Shopify hard-caps at 250)

# shopee:                        # Shopee BR adapter (product pages via the Product JSON-LD spine)
#   currency: BRL               # label stamped on the envelope
#   language: pt-BR             # label stamped on the envelope
#                               # product pages only; search/category carry no embeddable structured data

# service:                          # vascod (`vasco serve`) coordination knobs
#   single_flight: true            # collapse concurrent identical fetches into one (default on)
#   rate_limit_rps: 1.0            # max network fetch starts/sec per registered domain; 0 disables
#   max_concurrent_per_domain: 2  # max simultaneous in-flight fetches per registered domain; 0 = unlimited
#                                  # both pace before the fetch deadline starts, so queue wait is free
